      "tests/golden/**": "deny",
      "tests/fixtures/**": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "yarn.lock": "deny",
      "opencode.json": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      "docs/**": "deny",
      "tasks/**": "deny",
      "reports/**": "deny",
      "scripts/**": "deny",
      ".github/**": "deny",
