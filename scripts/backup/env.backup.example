# Mẫu cấu hình backup (T0.1). Chép thành file .env.backup ở THƯ MỤC GỐC repo:
#   cp scripts/backup/env.backup.example .env.backup && chmod 600 .env.backup
# .env.backup đã nằm trong .gitignore — KHÔNG commit, KHÔNG dán nội dung vào chat / AI.
# Cách lấy từng giá trị: docs/runbooks/backup.md (Bước 2).

# ── PRODUCTION (chỉ ĐỌC) ──────────────────────────────────────────────────────
# Supabase › Connect › "Session pooler" (cổng 5432) — thay [YOUR-PASSWORD] bằng mật khẩu database.
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Supabase › Project Settings › API (dùng để tải file trong Storage).
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Nơi lưu backup — PHẢI ở ngoài repo (mặc định ~/CRM-backups).
BACKUP_ROOT="$HOME/CRM-backups"
# Bucket Storage cần tải (thêm app-releases nếu muốn giữ cả file APK).
BACKUP_BUCKETS="customer-docs customer-avatars"

# ── STAGING (đích khôi phục thử — T0.5) ───────────────────────────────────────
# Để trống tới khi đã tạo project staging. restore-staging.sh từ chối nếu trùng production.
STAGING_DB_URL=""
STAGING_URL=""
STAGING_SERVICE_ROLE_KEY=""
